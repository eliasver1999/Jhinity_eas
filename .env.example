# Postgres — local Docker (docker compose up -d), Neon, or Supabase
DATABASE_URL=postgres://postgres:postgres@localhost:5432/eas_dashboard

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# Auth.js trusts the host header in dev; set to your prod URL in prod
AUTH_URL=http://localhost:3000

# GitHub OAuth — https://github.com/settings/applications/new
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend — invite emails. Leave blank in dev; invites will log to console.
RESEND_API_KEY=
RESEND_FROM="EAS Dashboard <onboarding@yourdomain.com>"

# Public base URL for emails/links
APP_URL=http://localhost:3000

# AES-256-GCM key for encrypting customer EAS tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
